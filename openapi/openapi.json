  "info": {
    "description": "Alleen-lezen API met Priva-dagwaarden (implementatieplan v1.1, sectie 8).\n\n* Authenticatie: `Authorization: Bearer <token>`; scope `read:data` voor alle GET-endpoints.\n* Fouten: `application/problem+json` met `type`, `title`, `status`, `detail`.\n* Leeg is niet nul: een ontbrekende waarde is `null` met quality `ontbreekt`.\n* Datums zijn lokale datums (Europe/Amsterdam).\n",
    "title": "Priva Bridge API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/koppeling/v1/datasets/{naam}": {
      "get": {
        "operationId": "dataset_api_koppeling_v1_datasets__naam__get",
        "parameters": [
          {
            "in": "path",
            "name": "naam",
            "required": true,
            "schema": {
              "title": "Naam",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sinds",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sinds"
            }
          },
          {
            "in": "query",
            "name": "limiet",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limiet",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Dataset (alleen-lezen)",
        "tags": [
          "bedrijfskoppeling"
        ]
      }
    },
