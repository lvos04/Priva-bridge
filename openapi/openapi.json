    "/api/v1/daily": {
      "get": {
        "description": "Een gevraagde dag zonder data komt terug als regel met quality `ontbreekt` en value null. Volgorde: scope (zoals gevraagd), metric (catalogusvolgorde of zoals gevraagd), datum.",
        "operationId": "get_daily_api_v1_daily_get",
        "parameters": [
          {
            "description": "Een of meer: bedrijf, afdeling:N, kap:N, bron:<type>:N",
            "in": "query",
            "name": "scope",
            "required": true,
            "schema": {
              "description": "Een of meer: bedrijf, afdeling:N, kap:N, bron:<type>:N",
              "items": {
                "type": "string"
              },
              "title": "Scope",
              "type": "array"
            }
          },
          {
            "description": "Lokale datum (Europe/Amsterdam), inclusief",
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "description": "Lokale datum (Europe/Amsterdam), inclusief",
              "format": "date",
              "title": "From",
              "type": "string"
            }
          },
          {
            "description": "Lokale datum (Europe/Amsterdam), inclusief",
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "description": "Lokale datum (Europe/Amsterdam), inclusief",
              "format": "date",
              "title": "To",
              "type": "string"
            }
          },
          {
            "description": "Optioneel, een of meer metric-sleutels",
            "in": "query",
            "name": "metric",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optioneel, een of meer metric-sleutels",
              "title": "Metric"
            }
          },
          {
            "description": "Kap krijgt afdelingswaarden; zie resolved_from",
            "in": "query",
            "name": "inherit",
            "required": false,
            "schema": {
              "default": false,
              "description": "Kap krijgt afdelingswaarden; zie resolved_from",
              "title": "Inherit",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 500,
              "maximum": 5000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Daily"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Ongeldig verzoek"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Geen of ongeldig token"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Token mist de vereiste scope"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Ongeldige parameters"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Rate limit bereikt (zie Retry-After)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Dagwaarden met dekking en kwaliteit",
        "tags": [
          "data"
        ]
      }
    },
